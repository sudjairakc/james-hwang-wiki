---
import WikiLayout from '../../../layouts/WikiLayout.astro';
const base = import.meta.env.BASE_URL;

const slugMap: Record<string, {
  title: string; phase: string; year: string; date: string; director: string; color: string; role: string;
  screenwriters: string; producers: string; starring: string; boxOffice: string | null; rtScore: string | null;
  showCredits: boolean;
}> = {
  'legend-of-the-ten-rings': {
    title: 'Shang-Chi and the Legend of the Ten Rings',
    phase: 'MCU Phase 4',
    year: '2021',
    date: '3 กันยายน 2021',
    director: 'Destin Daniel Cretton',
    color: '#7c5a3a',
    role: 'James Hwang รับบท Shang-Chi (Xu Shang-Chi)',
    screenwriters: 'Dave Callaham · Destin Daniel Cretton · Andrew Lanham',
    producers: 'Kevin Feige · Jonathan Schwartz',
    starring: 'James Hwang, Ashley Liao, Tony Leung, Fala Chen, Florian Munteanu, Michelle Yeoh, Ben Kingsley, Benedict Wong, Brie Larson, Mark Ruffalo',
    boxOffice: '$432M',
    rtScore: '91%',
    showCredits: true,
  },
  'legacy-of-the-ten-rings': {
    title: 'Shang-Chi and the Legacy of the Ten Rings',
    phase: 'MCU Phase 5',
    year: '2025',
    date: '25 กรกฎาคม 2025',
    director: 'Destin Daniel Cretton',
    color: '#7c5a3a',
    role: 'James Hwang รับบท Shang-Chi · ผู้ร่วมเขียนบท',
    screenwriters: 'Dave Callaham · Destin Daniel Cretton · Andrew Lanham · James Hwang',
    producers: 'Kevin Feige · Jonathan Schwartz',
    starring: 'James Hwang, Ashley Liao, Michelle Yeoh, Chow Yun-fat, Brie Larson, Anthony Mackie, Paul Rudd, Florian Munteanu',
    boxOffice: '$610M',
    rtScore: '88%',
    showCredits: true,
  },
  'deadly-hands': {
    title: 'Shang-Chi and the Deadly Hands',
    phase: 'MCU Phase 6',
    year: '2026',
    date: '18 กันยายน 2026',
    director: 'Isaiah Saxon',
    color: '#7c5a3a',
    role: 'James Hwang รับบท Shang-Chi · ผู้ร่วมเขียนบท',
    screenwriters: 'Isaiah Saxon · Jonathan Wang · James Hwang',
    producers: 'Kevin Feige · Jonathan Schwartz',
    starring: 'James Hwang, Ashley Liao, Benedict Wong, Florian Munteanu',
    boxOffice: null,
    rtScore: null,
    showCredits: true,
  },
  'trilogy-analysis': {
    title: 'Shang-Chi Trilogy — บทวิเคราะห์เชิงลึก',
    phase: 'MCU Trilogy',
    year: '2021–2026',
    date: '',
    director: '',
    color: '#7c5a3a',
    role: '',
    screenwriters: '',
    producers: '',
    starring: '',
    boxOffice: null,
    rtScore: null,
    showCredits: false,
  },
};

export function getStaticPaths() {
  return [
    'legend-of-the-ten-rings',
    'legacy-of-the-ten-rings',
    'deadly-hands',
    'trilogy-analysis',
  ].map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;
const meta = slugMap[slug];

const modules = import.meta.glob('../../../content/wiki/filmography/shang-chi/*.md');
const key = `../../../content/wiki/filmography/shang-chi/${slug}.md`;
const mod = await modules[key]() as { Content: any };
const { Content } = mod;
---

<WikiLayout title={meta.title} section="Filmography" relatedPages={[
  { label: 'Shang-Chi Trilogy', href: `${base}filmography/shang-chi` },
  { label: 'บทวิเคราะห์ไตรภาค', href: `${base}filmography/shang-chi/trilogy-analysis` },
  { label: 'Filmography', href: `${base}filmography` },
  { label: 'RESONANCE Franchise', href: `${base}filmography/resonance` },
  { label: 'Awards', href: `${base}awards` },
  { label: 'Career Timeline', href: `${base}timeline` },
]}>
  <a href={`${base}filmography/shang-chi`}
    class="inline-flex items-center gap-1.5 text-xs mb-6 transition-colors" style="color:var(--text-muted)">
    ← กลับไป Shang-Chi Trilogy
  </a>

  <!-- Header -->
  <div class="mb-8">
    <div class="text-xs font-semibold uppercase tracking-widest mb-1" style={`color:${meta.color}`}>
      {meta.phase} · Shang-Chi Trilogy
    </div>
    <h1 class="wiki-title mb-2">{meta.title}</h1>
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-xs px-2 py-0.5 rounded font-semibold" style={`background-color:${meta.color}18;color:${meta.color}`}>{meta.year}</span>
      {meta.showCredits && (
        meta.boxOffice
          ? <span class="text-xs px-2 py-0.5 rounded-full font-semibold" style="background-color:#3a6a3a30;color:#5aaa5a">เข้าฉายแล้ว</span>
          : <span class="text-xs px-2 py-0.5 rounded-full font-semibold" style="background-color:#6a6a1a30;color:#aaaa3a">เร็วๆ นี้</span>
      )}
    </div>
  </div>

  <!-- KPIs -->
  {meta.boxOffice && (
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-8">
      {[
        { val: meta.date, label: 'วันเข้าฉาย' },
        { val: meta.director.split(' ').slice(-1)[0], label: 'ผู้กำกับ' },
        { val: meta.boxOffice, label: 'บ็อกซ์ออฟฟิศ' },
        { val: meta.rtScore ?? '—', label: 'Rotten Tomatoes' },
      ].map(s => (
        <div class="stat-card">
          <div class="stat-val text-base">{s.val}</div>
          <div class="stat-label">{s.label}</div>
        </div>
      ))}
    </div>
  )}

  <!-- Credits block -->
  {meta.showCredits && (
    <div class="rounded-lg border overflow-hidden mb-8" style="border-color:var(--border)">
      <div class="px-4 py-2.5 border-b text-xs font-semibold uppercase tracking-widest" style={`border-color:${meta.color}44;background-color:${meta.color}08;color:${meta.color}`}>เครดิต</div>
      <div style="background-color:var(--bg-surface)">
        {[
          { label: 'ผู้กำกับ', val: meta.director },
          { label: 'บทภาพยนตร์', val: meta.screenwriters },
          { label: 'โปรดิวเซอร์', val: meta.producers },
          { label: 'นักแสดงนำ', val: meta.starring },
          { label: meta.date ? 'วันเข้าฉาย' : 'กำหนดเข้าฉาย', val: meta.date || meta.year },
          { label: 'บทบาทของเจมส์', val: meta.role },
        ].map((r, i, arr) => (
          <div class="flex gap-4 px-4 py-2.5" style={i < arr.length - 1 ? 'border-bottom:1px solid color-mix(in srgb, var(--border) 50%, transparent)' : ''}>
            <div class="text-xs font-semibold w-28 shrink-0 mt-0.5" style="color:var(--text-muted)">{r.label}</div>
            <div class="text-sm leading-relaxed">{r.val}</div>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- Plot / content -->
  <div class="film-prose prose prose-invert max-w-none">
    <Content />
  </div>
</WikiLayout>

<style>
  .film-prose :global(h2) {
    display: none;
  }
  .film-prose :global(h3) {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--gold);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
  }
  .film-prose :global(h4) {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .film-prose :global(ul) {
    padding-left: 1.25rem;
    margin-top: 0;
    margin-bottom: 0.5rem;
  }
  .film-prose :global(li) {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 0.5rem;
  }
  .film-prose :global(p) {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.75;
    margin-bottom: 0.85rem;
  }
  .film-prose :global(strong) {
    color: var(--text);
    font-weight: 600;
  }
  .film-prose :global(em) {
    color: var(--text-muted);
    opacity: 0.9;
  }
  .film-prose :global(hr) {
    border-color: color-mix(in srgb, var(--border) 50%, transparent);
    margin: 1.5rem 0;
  }
</style>
