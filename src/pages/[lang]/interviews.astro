---
import WikiLayout from '../../layouts/WikiLayout.astro';
import { langStaticPaths, type Lang } from '../../i18n';
import { getInterviews } from '../../data/pages/interviews';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = Astro.params.lang as Lang;
const base = import.meta.env.BASE_URL;
const L = `${base}${lang}/`;
const d = getInterviews(lang);

const related = d.related.map(r => ({ label: r.label, href: `${L}${r.slug}` }));
---
<WikiLayout title={d.ui.title} section="Biography" lang={lang} relatedPages={related}>
  <div class="mb-8">
    <div class="wiki-label mb-2">{d.ui.label}</div>
    <h1 class="wiki-title mb-2">{d.ui.title}</h1>
    <p class="text-sm" style="color:var(--text-muted)">{d.ui.subtitle}</p>
  </div>

  <!-- Signature Quotes by Theme -->
  <section class="mb-12">
    <h2 class="wiki-section mb-6">{d.ui.signatureQuotesHeading}</h2>
    <div class="space-y-8">
      {d.themes.map(t => (
        <div>
          <div class="flex items-center gap-3 mb-3">
            <div class="w-2 h-2 rounded-full" style={`background-color:${t.color}`}></div>
            <span class="text-xs font-semibold uppercase tracking-widest" style={`color:${t.color}`}>{t.theme}</span>
          </div>
          <div class="space-y-2">
            {t.quotes.map(q => (
              <div class="rounded-lg border-l-2 pl-4 py-3 pr-4" style={`border-color:${t.color};background-color:color-mix(in srgb,${t.color} 4%,var(--bg-surface))`}>
                <p class="text-sm leading-relaxed italic mb-2">"{q.quote}"</p>
                <div class="text-xs" style="color:var(--text-muted)">— {q.source}, {q.year}</div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Key Interviews -->
  <section>
    <h2 class="wiki-section mb-6">{d.ui.keyInterviewsHeading}</h2>
    <div class="space-y-6">
      {d.interviews.map(iv => (
        <div class="rounded-xl border overflow-hidden" style={`border-color:color-mix(in srgb,${iv.color} 25%,var(--border))`}>
          <!-- Header -->
          <div class="px-5 py-3 flex flex-wrap items-center gap-3" style={`background-color:color-mix(in srgb,${iv.color} 7%,var(--bg-surface))`}>
            <span class="font-bold text-sm" style={`color:${iv.color}`}>{iv.outlet}</span>
            <span class="text-xs px-2 py-0.5 rounded" style="background-color:var(--bg-muted);color:var(--text-muted)">{iv.platform}</span>
            <span class="text-xs px-2 py-0.5 rounded" style="background-color:var(--bg-muted);color:var(--text-muted)">{iv.type}</span>
            <span class="text-xs font-mono ml-auto" style="color:var(--text-muted)">{iv.year}</span>
          </div>
          <!-- Context -->
          <div class="px-5 py-3 border-t text-sm leading-relaxed" style={`border-color:color-mix(in srgb,var(--border) 50%,transparent);background-color:var(--bg-surface);color:var(--text-muted)`}>
            {iv.context}
          </div>
          <!-- Quotes -->
          <div class="border-t" style="border-color:color-mix(in srgb,var(--border) 50%,transparent)">
            {iv.notable.map((n, i, arr) => (
              <div class="px-5 py-4" style={`background-color:var(--bg-surface);${i < arr.length - 1 ? 'border-bottom:1px solid color-mix(in srgb,var(--border) 40%,transparent)' : ''}`}>
                <div class="text-xs font-semibold uppercase tracking-wide mb-2" style={`color:${iv.color}`}>{n.topic}</div>
                <p class="text-sm leading-relaxed italic" style="color:var(--text-muted)">"{n.quote}"</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</WikiLayout>
