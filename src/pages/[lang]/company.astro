---
import WikiLayout from '../../layouts/WikiLayout.astro';
import { langStaticPaths, type Lang } from '../../i18n';
import { getCompany } from '../../data/pages/company';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = Astro.params.lang as Lang;
const base = import.meta.env.BASE_URL;
const L = `${base}${lang}/`;
const d = getCompany(lang);
const introHtml = d.ui.introHtml.replaceAll('%L%', L);

const relatedLabels = {
  legal: { en: 'Legal', th: 'กฎหมาย' },
  ecosystem: { en: 'Endorsements', th: 'พรีเซ็นเตอร์' },
  timeline: { en: 'Career Timeline', th: 'ไทม์ไลน์อาชีพ' },
  discography: { en: 'Discography', th: 'ผลงานเพลง' },
  tours: { en: 'Tours', th: 'ทัวร์คอนเสิร์ต' },
};
const related = [
  { label: relatedLabels.legal[lang], href: `${L}legal` },
  { label: relatedLabels.ecosystem[lang], href: `${L}ecosystem` },
  { label: relatedLabels.timeline[lang], href: `${L}timeline` },
  { label: relatedLabels.discography[lang], href: `${L}discography` },
  { label: relatedLabels.tours[lang], href: `${L}tours` },
];
---
<WikiLayout title={d.ui.title} section="Business" lang={lang} relatedPages={related}>
  <div class="mb-8">
    <div class="wiki-label mb-2">{d.ui.label}</div>
    <h1 class="wiki-title mb-2">{d.ui.title}</h1>
    <p class="text-sm mb-3" style="color:var(--text-muted)">{d.ui.subtitle}</p>
    <p class="text-sm leading-7 max-w-3xl" style="color:var(--text-muted)" set:html={introHtml}></p>
  </div>

  <!-- KPI Cards -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-10">
    {d.kpis.map(k => (
      <div class="stat-card">
        <div class="stat-val">{k.val}</div>
        <div class="stat-label">{k.label}</div>
        <div class="text-xs mt-1" style="color:color-mix(in srgb, var(--text-muted) 60%, transparent)">{k.sub}</div>
      </div>
    ))}
  </div>

  <!-- Brand Identity -->
  <section class="mb-10">
    <h2 class="wiki-section mb-4">{d.ui.brandHeading}</h2>
    <div class="rounded-xl border overflow-hidden mb-4" style="border-color:color-mix(in srgb, var(--gold) 30%, transparent)">
      <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x" style="--tw-divide-opacity:1;divide-color:var(--border)">
        {[
          { label: d.ui.brandNameLabel, val: d.brand.meaning },
          { label: d.ui.brandTaglineLabel, val: d.brand.tagline },
          { label: d.ui.brandPlatformLabel, val: d.brand.platform },
        ].map(f => (
          <div class="px-5 py-4" style="background-color:color-mix(in srgb, var(--gold) 5%, var(--bg-surface))">
            <div class="text-xs font-semibold uppercase tracking-widest mb-1" style="color:var(--text-muted)">{f.label}</div>
            <div class="text-base font-bold" style="color:var(--gold)">{f.val}</div>
          </div>
        ))}
      </div>
      <div class="px-5 py-4 border-t" style="border-color:var(--border);background-color:var(--bg-surface)">
        <div class="text-xs font-semibold uppercase tracking-widest mb-1.5" style="color:var(--text-muted)">{d.ui.brandPositioningLabel}</div>
        <p class="text-sm leading-relaxed" style="color:var(--text-muted)">{d.brand.positioning}</p>
      </div>
    </div>

    <!-- Pillars -->
    <div class="text-xs font-semibold uppercase tracking-widest mb-2" style="color:var(--text-muted)">{d.ui.brandPillarsLabel}</div>
    <div class="grid grid-cols-1 md:grid-cols-5 gap-3 mb-5">
      {d.brand.pillars.map(p => (
        <div class="stat-card flex flex-col gap-1.5">
          <div class="text-sm font-bold" style="color:var(--gold)">{p.name}</div>
          <div class="text-xs leading-relaxed" style="color:var(--text-muted)">{p.desc}</div>
        </div>
      ))}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <div class="text-xs font-semibold uppercase tracking-widest mb-2" style="color:var(--text-muted)">{d.ui.brandPersonalityLabel}</div>
        <div class="flex flex-wrap gap-2">
          {d.brand.personality.map(t => (
            <span class="text-xs px-2.5 py-1 rounded border" style="border-color:var(--border);color:var(--text-muted);background-color:var(--bg-muted)">{t}</span>
          ))}
        </div>
      </div>
      <div>
        <div class="text-xs font-semibold uppercase tracking-widest mb-2" style="color:var(--text-muted)">{d.ui.brandArchetypeLabel}</div>
        <div class="flex flex-wrap gap-2">
          {d.brand.archetype.map(t => (
            <span class="text-xs px-2.5 py-1 rounded border" style="border-color:color-mix(in srgb, var(--gold) 30%, transparent);color:var(--gold);background-color:color-mix(in srgb, var(--gold) 8%, transparent)">{t}</span>
          ))}
        </div>
      </div>
    </div>

    <!-- CI board figure -->
    <figure class="mt-6">
      <div class="rounded-xl border overflow-hidden" style="border-color:var(--border);background-color:var(--bg-surface)">
        <img src={`${base}brand/${d.brand.image}`} alt={d.ui.brandBoardLabel} class="w-full h-auto block" loading="lazy" />
      </div>
      <figcaption class="text-xs mt-2 leading-relaxed" style="color:var(--text-faint)">
        <span class="font-semibold" style="color:var(--text-muted)">{d.ui.brandBoardLabel}. </span>{d.brand.imageCaption}
      </figcaption>
    </figure>
  </section>

  <!-- Ownership -->
  <section class="mb-10">
    <h2 class="wiki-section mb-4">{d.ui.ownershipHeading}</h2>
    <div class="rounded-lg overflow-hidden border" style="border-color:var(--border)">
      <table class="w-full text-sm" style="margin:0">
        <thead>
          <tr style="background-color:color-mix(in srgb, var(--gold) 8%, var(--bg-surface));border-bottom:1px solid var(--gold)">
            <th class="text-left px-4 py-2.5 text-xs font-semibold uppercase tracking-widest" style="color:var(--gold)">{d.ui.tableShareholder}</th>
            <th class="text-left px-4 py-2.5 text-xs font-semibold uppercase tracking-widest" style="color:var(--gold)">{d.ui.tableOwnership}</th>
            <th class="text-left px-4 py-2.5 text-xs font-semibold uppercase tracking-widest" style="color:var(--gold)">{d.ui.tableRole}</th>
          </tr>
        </thead>
        <tbody style="background-color:var(--bg-surface)">
          {d.ownershipRows.map((r, i, arr) => (
            <tr style={i < arr.length - 1 ? 'border-bottom:1px solid color-mix(in srgb, var(--border) 50%, transparent)' : ''}>
              <td class="px-4 py-3 font-medium" style="color:var(--text)">{r.who}</td>
              <td class="px-4 py-3">
                <div class="flex items-center gap-3">
                  <span class="font-bold text-base" style="color:var(--gold)">{r.pct}</span>
                  <div class="flex-1 h-1.5 rounded-full overflow-hidden max-w-24" style="background-color:var(--bg-muted)">
                    <div class="h-full rounded-full" style={`width:${r.w}%;background-color:var(--gold);opacity:0.7`}></div>
                  </div>
                </div>
              </td>
              <td class="px-4 py-3 text-sm" style="color:var(--text-muted)">{r.role}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Divisions -->
  <section class="mb-10">
    <h2 class="wiki-section mb-4">{d.ui.divisionsHeading}</h2>
    <div class="grid grid-cols-1 md:grid-cols-5 gap-3">
      {d.divisions.map(dv => (
        <div class="stat-card flex flex-col gap-2">
          <div class="text-xl" style="color:var(--gold)">{dv.icon}</div>
          <div class="text-sm font-bold">{dv.name}</div>
          <div class="text-xs leading-relaxed" style="color:var(--text-muted)">{dv.desc}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- Revenue mix -->
  <section class="mb-10">
    <h2 class="wiki-section mb-4">{d.ui.revenueHeading}</h2>
    <div class="rounded-lg border overflow-hidden" style="border-color:var(--border)">
      {d.revenue.map((r, i) => (
        <div class="flex items-center gap-4 px-4 py-3" style={`background-color:var(--bg-surface);${i > 0 ? 'border-top:1px solid color-mix(in srgb, var(--border) 50%, transparent)' : ''}`}>
          <div class="w-36 shrink-0">
            <div class="text-xs font-semibold">{r.segment}</div>
            <div class="text-xs" style="color:var(--gold)">{r.share}</div>
          </div>
          <div class="flex-1 h-1.5 rounded-full overflow-hidden" style="background-color:var(--bg-muted)">
            <div class="h-full rounded-full transition-all" style={`width:${r.pct}%;background-color:var(--gold);opacity:${0.4 + r.pct / 100}`}></div>
          </div>
          <div class="text-xs w-48 text-right shrink-0" style="color:var(--text-muted)">{r.role}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- IP Portfolio -->
  <section class="mb-10">
    <h2 class="wiki-section mb-4">{d.ui.ipHeading}</h2>
    <div class="rounded-lg border overflow-hidden" style="border-color:var(--border)">
      {d.ipPortfolio.map((ip, i, arr) => (
        <div class="flex gap-5 px-5 py-4" style={`background-color:var(--bg-surface);${i < arr.length - 1 ? 'border-bottom:1px solid color-mix(in srgb, var(--border) 50%, transparent)' : ''}`}>
          <div class="shrink-0 w-40 pt-0.5">
            <div class="text-sm font-bold mb-1">{ip.asset}</div>
            <span class="text-xs px-2 py-0.5 rounded" style="background-color:var(--bg-muted);color:var(--text-muted)">{ip.type}</span>
          </div>
          <div class="flex-1">
            <div class="text-xs font-semibold mb-1.5" style="color:var(--gold)">{ip.ownership}</div>
            <p class="text-sm leading-relaxed" style="color:var(--text-muted)">{ip.detail}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Merchandise & Product Lines -->
  <section class="mb-10">
    <h2 class="wiki-section mb-4">{d.ui.merchHeading}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      {d.merchandise.map(m => (
        <div class="rounded-lg border px-4 py-3" style="border-color:var(--border);background-color:var(--bg-surface)">
          <div class="flex items-start justify-between gap-2 mb-1.5">
            <div class="text-sm font-bold">{m.line}</div>
            <span class="text-xs px-2 py-0.5 rounded shrink-0" style="background-color:color-mix(in srgb,var(--gold) 10%,transparent);color:var(--gold)">{m.category}</span>
          </div>
          <div class="text-xs font-mono mb-2" style="color:var(--text-muted)">{m.scale}</div>
          <p class="text-sm leading-relaxed" style="color:var(--text-muted)">{m.detail}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Company Culture -->
  <section class="mb-10">
    <h2 class="wiki-section mb-4">{d.ui.cultureHeading}</h2>
    <div class="space-y-3">
      {d.companyCulture.map(c => (
        <div class="rounded-lg border-l-2 pl-4 py-3 pr-4" style={`border-color:${c.color};background-color:color-mix(in srgb,${c.color} 4%,var(--bg-surface))`}>
          <div class="text-xs font-semibold uppercase tracking-widest mb-1.5" style={`color:${c.color}`}>{c.label}</div>
          <p class="text-sm leading-relaxed" style="color:var(--text-muted)">{c.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Valuation phases -->
  <section class="mb-10">
    <h2 class="wiki-section mb-4">{d.ui.valuationHeading}</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      {d.valPhases.map((v, i) => (
        <div class="stat-card border" style={`border-color:${i === 2 ? 'color-mix(in srgb, var(--gold) 40%, transparent)' : 'var(--border)'}`}>
          <div class="text-xs font-semibold uppercase tracking-widest mb-1" style="color:var(--text-muted)">{v.phase}</div>
          <div class="text-2xl font-black mb-1" style="color:var(--gold)">{v.range}</div>
          <div class="text-xs" style="color:var(--text-muted)">{v.trigger}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- Roster -->
  <section class="mb-10">
    <h2 class="wiki-section mb-4">{d.ui.rosterHeading}</h2>
    <div class="flex flex-wrap gap-2 mb-3">
      {d.roster.map(a => (
        <div class="flex items-center gap-3 px-4 py-2.5 rounded-lg border" style="border-color:var(--border);background-color:var(--bg-surface)">
          <div>
            <div class="text-sm font-bold">{a.name}</div>
            <div class="text-xs" style="color:var(--text-muted)">{a.role} · {a.since}</div>
          </div>
        </div>
      ))}
    </div>
    <p class="text-xs leading-relaxed" style="color:var(--text-faint)">{d.ui.rosterNote}</p>
  </section>

  <!-- Strategic partners -->
  <section class="mb-10">
    <h2 class="wiki-section mb-4">{d.ui.partnersHeading}</h2>
    <div class="rounded-lg overflow-hidden border" style="border-color:var(--border)">
      <table class="w-full text-sm" style="margin:0">
        <thead>
          <tr style="background-color:color-mix(in srgb, var(--gold) 8%, var(--bg-surface));border-bottom:1px solid var(--gold)">
            <th class="text-left px-4 py-2.5 text-xs font-semibold uppercase tracking-widest" style="color:var(--gold)">{d.ui.tablePartner}</th>
            <th class="text-left px-4 py-2.5 text-xs font-semibold uppercase tracking-widest" style="color:var(--gold)">{d.ui.tableLayer}</th>
            <th class="text-left px-4 py-2.5 text-xs font-semibold uppercase tracking-widest" style="color:var(--gold)">{d.ui.tableRole}</th>
          </tr>
        </thead>
        <tbody style="background-color:var(--bg-surface)">
          {d.partners.map((p, i, arr) => (
            <tr style={i < arr.length - 1 ? 'border-bottom:1px solid color-mix(in srgb, var(--border) 50%, transparent)' : ''}>
              <td class="px-4 py-3 font-semibold">{p.name}</td>
              <td class="px-4 py-3">
                <span class="text-xs px-2 py-0.5 rounded" style="background-color:var(--bg-muted);color:var(--text-muted)">{p.layer}</span>
              </td>
              <td class="px-4 py-3 text-sm" style="color:var(--text-muted)">{p.role}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</WikiLayout>
