---
import WikiLayout from '../../layouts/WikiLayout.astro';
import { langStaticPaths, type Lang } from '../../i18n';
import { getLegal } from '../../data/pages/legal';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = Astro.params.lang as Lang;
const base = import.meta.env.BASE_URL;
const L = `${base}${lang}/`;
const d = getLegal(lang);
const introHtml = d.ui.introHtml.replaceAll('%L%', L);

const related = d.related.map(r => ({ label: r.label, href: `${L}${r.slug}` }));
---
<WikiLayout title={d.ui.title} section="History" lang={lang} relatedPages={related}>
  <div class="mb-8">
    <div class="wiki-label mb-2">{d.ui.label}</div>
    <h1 class="wiki-title mb-2">{d.ui.heading}</h1>
    <p class="text-sm mb-3" style="color:var(--text-muted)">{d.ui.subtitle}</p>
    <p class="text-sm leading-7 max-w-3xl" style="color:var(--text-muted)" set:html={introHtml}></p>
  </div>

  <!-- Outcome summary banner -->
  <div class="rounded-lg border px-5 py-4 mb-10 flex flex-col md:flex-row md:items-start gap-4"
    style="border-color:color-mix(in srgb, #22c55e 30%, transparent);background-color:color-mix(in srgb, #22c55e 5%, var(--bg-surface))">
    <div class="shrink-0">
      <div class="text-2xl">⚖</div>
    </div>
    <div class="flex-1">
      <div class="text-sm font-bold mb-2">{d.ui.outcomeHeading}</div>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-x-8 gap-y-1.5">
        {d.outcome.map(o => (
          <div>
            <div class="text-xs" style="color:var(--text-muted)">{o.label}</div>
            <div class="text-xs font-semibold">{o.val}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Core issues -->
  <section class="mb-10">
    <h2 class="wiki-section mb-4">{d.ui.issuesHeading}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      {d.issues.map(issue => (
        <div class="rounded-lg border px-4 py-3" style={`border-color:${issue.severity === 'high' ? 'color-mix(in srgb, #ef4444 25%, transparent)' : 'var(--border)'};background-color:var(--bg-surface)`}>
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs font-bold px-2 py-0.5 rounded uppercase tracking-wide"
              style={`background-color:${issue.severity === 'high' ? 'color-mix(in srgb, #ef4444 12%, transparent)' : 'var(--bg-muted)'};color:${issue.severity === 'high' ? '#f87171' : 'var(--text-muted)'}`}>
              {d.ui.severityLabels[issue.severity]}
            </span>
            <span class="text-sm font-bold">{issue.title}</span>
          </div>
          <p class="text-sm leading-relaxed" style="color:var(--text-muted)">{issue.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Timeline -->
  <section class="mb-10">
    <h2 class="wiki-section mb-6">{d.ui.timelineHeading}</h2>
    <div class="relative">
      <!-- vertical line -->
      <div class="absolute left-[7px] top-2 bottom-2 w-px" style="background-color:var(--border)"></div>
      <div class="flex flex-col gap-6">
        {d.timeline.map(ev => {
          const dotColor = ev.status === 'resolved' ? '#4ade80' : ev.status === 'alert' ? '#f87171' : ev.status === 'warning' ? '#facc15' : 'var(--text-muted)';
          return (
            <div class="flex gap-5 pl-6 relative">
              <!-- dot -->
              <div class="absolute left-0 top-1.5 w-3.5 h-3.5 rounded-full border-2 shrink-0"
                style={`background-color:color-mix(in srgb, ${dotColor} 20%, var(--bg));border-color:${dotColor}`}></div>
              <div class="flex-1">
                <div class="flex items-baseline gap-3 mb-1 flex-wrap">
                  <span class="text-xs font-mono font-semibold px-2 py-0.5 rounded" style="background-color:var(--bg-muted);color:var(--text-muted)">{ev.period}</span>
                  <span class="text-sm font-bold">{ev.label}</span>
                </div>
                <p class="text-sm leading-relaxed" style="color:var(--text-muted)">{ev.text}</p>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Aftermath -->
  <section>
    <h2 class="wiki-section mb-4">{d.ui.aftermathHeading}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      {d.aftermath.map((a, i) => (
        <div class={`rounded-lg border px-4 py-3 ${i === d.aftermath.length - 1 ? 'md:col-span-2' : ''}`} style="border-color:var(--border);background-color:var(--bg-surface)">
          <div class="text-xs font-semibold uppercase tracking-widest mb-2" style="color:var(--text-muted)">{a.title}</div>
          <p class="text-sm leading-relaxed" style="color:var(--text-muted)">{a.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Cross-border legal structure -->
  <section class="mt-10">
    <h2 class="wiki-section mb-4">{d.ui.structureHeading}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      {d.structure.map(s => (
        <div class="rounded-lg border px-4 py-3" style="border-color:var(--border);background-color:var(--bg-surface)">
          <div class="text-xs font-semibold uppercase tracking-widest mb-2" style="color:var(--text-muted)">{s.title}</div>
          <p class="text-sm leading-relaxed" style="color:var(--text-muted)">{s.text}</p>
        </div>
      ))}
    </div>
  </section>
</WikiLayout>
