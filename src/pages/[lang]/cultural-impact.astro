---
import WikiLayout from '../../layouts/WikiLayout.astro';
import { langStaticPaths, type Lang } from '../../i18n';
import { getCulturalImpact } from '../../data/pages/cultural-impact';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = Astro.params.lang as Lang;
const base = import.meta.env.BASE_URL;
const L = `${base}${lang}/`;
const d = getCulturalImpact(lang);

const related = d.related.map(r => ({ label: r.label, href: `${L}${r.slug}` }));
---
<WikiLayout title={d.ui.title} section="Analysis" lang={lang} relatedPages={related}>
  <div class="mb-8">
    <div class="wiki-label mb-2">{d.ui.label}</div>
    <h1 class="wiki-title mb-2">{d.ui.title}</h1>
    <p class="text-sm" style="color:var(--text-muted)">{d.ui.subtitle}</p>
  </div>

  <!-- Section tabs indicator -->
  <div class="flex gap-3 mb-10">
    {[
      { label: d.ui.tab1, count: d.academicItems.length },
      { label: d.ui.tab2, count: d.fandomItems.length },
    ].map(t => (
      <div class="flex items-center gap-2 px-3 py-1.5 rounded-md border text-xs font-semibold" style="border-color:var(--border);background-color:var(--bg-surface);color:var(--text-muted)">
        {t.label}
        <span class="px-1.5 py-0.5 rounded text-xs font-bold" style="background-color:var(--bg-muted);color:var(--gold)">{t.count}</span>
      </div>
    ))}
  </div>

  <!-- ── Stature / By the Numbers ── -->
  <section class="mb-12">
    <h2 class="wiki-section mb-1 pb-2 border-b" style="border-color:var(--border)">{d.ui.statureHeading}</h2>
    <p class="text-xs mt-2 mb-4" style="color:var(--text-faint)">{d.ui.statureSub}</p>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
      {d.scoreboard.map(s => (
        <div class="stat-card">
          <div class="stat-val">{s.val}</div>
          <div class="stat-label">{s.label}</div>
          <div class="text-xs mt-1" style="color:color-mix(in srgb, var(--text-muted) 60%, transparent)">{s.sub}</div>
        </div>
      ))}
    </div>
    <div class="rounded-lg border overflow-hidden" style="border-color:color-mix(in srgb, var(--gold) 30%, transparent)">
      <div class="grid text-xs px-4 py-2" style="grid-template-columns:1.4fr 1.4fr 2fr;background-color:color-mix(in srgb, var(--gold) 6%, var(--bg-muted));border-bottom:1px solid color-mix(in srgb, var(--gold) 25%, transparent)">
        {d.statureTierCols.map((c, ci) => (
          <div class="font-semibold uppercase tracking-widest" style={`color:${ci === d.statureTierCols.length - 1 ? 'var(--gold)' : 'var(--text-muted)'}`}>{c}</div>
        ))}
      </div>
      {d.statureTiers.map((row, ri, arr) => (
        <div class="grid text-xs px-4 py-2.5" style={`grid-template-columns:1.4fr 1.4fr 2fr;background-color:var(--bg-surface);${ri < arr.length - 1 ? 'border-bottom:1px solid color-mix(in srgb, var(--border) 40%, transparent)' : ''}`}>
          {row.map((cell, ci) => (
            <div class={ci === 0 ? 'font-semibold' : ''} style={`color:${ci === 2 ? 'var(--gold)' : ci === 1 ? 'var(--text)' : 'var(--text-muted)'}`}>{cell}</div>
          ))}
        </div>
      ))}
    </div>
  </section>

  <!-- ── Academic Reception ── -->
  <section class="mb-12">
    <h2 class="wiki-section mb-6 pb-2 border-b" style="border-color:var(--border)">
      {d.ui.academicSectionHeading}
    </h2>
    <div class="flex flex-col gap-4">
      {d.academicItems.map(item => (
        <div class="rounded-lg border overflow-hidden" style="border-color:var(--border)">
          <!-- Item header -->
          <div class="flex items-start gap-3 px-4 py-3 border-b" style="border-color:var(--border);background-color:var(--bg-surface)">
            <span class="text-xs font-mono font-bold px-2 py-0.5 rounded shrink-0 mt-0.5" style="background-color:var(--bg-muted);color:var(--gold)">{item.id}</span>
            <div class="flex-1">
              <div class="text-sm font-bold">{item.title}</div>
              <div class="text-xs mt-0.5 italic" style="color:var(--text-muted)">"{item.tag}"</div>
            </div>
          </div>
          <!-- Body -->
          <div class="px-4 py-3" style="background-color:color-mix(in srgb, var(--bg-surface) 60%, var(--bg))">
            <p class="text-sm leading-relaxed mb-3" style="color:var(--text-muted)">{item.text}</p>
            {item.table && (
              <div class="rounded overflow-hidden border" style="border-color:color-mix(in srgb, var(--border) 60%, transparent)">
                <div class={`grid text-xs px-3 py-2`} style={`grid-template-columns:repeat(${item.table.cols.length}, 1fr);background-color:color-mix(in srgb, var(--gold) 6%, var(--bg-muted));border-bottom:1px solid color-mix(in srgb, var(--gold) 25%, transparent)`}>
                  {item.table.cols.map((c, ci) => (
                    <div class="font-semibold uppercase tracking-widest" style={`color:${ci === item.table!.cols.length - 1 ? 'var(--gold)' : 'var(--text-muted)'}`}>{c}</div>
                  ))}
                </div>
                {item.table.rows.map((row, ri) => (
                  <div class={`grid text-xs px-3 py-2`} style={`grid-template-columns:repeat(${item.table!.cols.length}, 1fr);background-color:var(--bg-surface);${ri < item.table!.rows.length - 1 ? 'border-bottom:1px solid color-mix(in srgb, var(--border) 40%, transparent)' : ''}`}>
                    {row.map((cell, ci) => (
                      <div class={ci === 0 ? 'font-semibold' : ''} style={`color:${ci === row.length - 1 ? 'var(--text)' : 'var(--text-muted)'}`}>{cell}</div>
                    ))}
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ── Fandom Sociology ── -->
  <section class="mb-12">
    <h2 class="wiki-section mb-6 pb-2 border-b" style="border-color:var(--border)">
      {d.ui.fandomSectionHeading}
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {d.fandomItems.map(item => (
        <div class="rounded-lg border overflow-hidden" style="border-color:var(--border);background-color:var(--bg-surface)">
          <div class="flex items-center gap-2.5 px-4 py-2.5 border-b" style="border-color:var(--border);background-color:var(--bg-muted)">
            <span class="text-xs font-mono font-bold px-1.5 py-0.5 rounded" style="background-color:var(--bg-surface);color:var(--gold)">{item.id}</span>
            <span class="text-sm font-bold">{item.title}</span>
          </div>
          <div class="px-4 py-3">
            {item.text && <p class="text-sm leading-relaxed" style="color:var(--text-muted)">{item.text}</p>}
            {item.paths && (
              <div class="flex flex-col gap-1.5">
                {item.paths.map(p => (
                  <div class="flex items-center gap-3">
                    <span class="text-xs font-bold px-2 py-0.5 rounded border shrink-0" style="border-color:color-mix(in srgb, var(--gold) 30%, transparent);color:var(--gold);background-color:color-mix(in srgb, var(--gold) 8%, transparent)">{p.path}</span>
                    <span class="text-xs" style="color:var(--text-muted)">{p.type}</span>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ── Legacy Projection ── -->
  <section>
    <h2 class="wiki-section mb-4 pb-2 border-b" style="border-color:var(--border)">
      {d.ui.legacyHeading}
    </h2>
    <div class="rounded-lg border overflow-hidden" style="border-color:color-mix(in srgb, var(--gold) 30%, transparent)">
      {d.legacyItems.map((l, i, arr) => (
        <div class="flex gap-4 px-5 py-3" style={`background-color:color-mix(in srgb, var(--gold) 5%, var(--bg-surface));${i < arr.length - 1 ? 'border-bottom:1px solid color-mix(in srgb, var(--gold) 15%, transparent)' : ''}`}>
          <span class="text-xs font-semibold uppercase tracking-widest w-44 shrink-0 pt-0.5" style="color:var(--text-muted)">{l.label}</span>
          <span class="text-sm font-bold">{l.val}</span>
        </div>
      ))}
    </div>
  </section>
</WikiLayout>
