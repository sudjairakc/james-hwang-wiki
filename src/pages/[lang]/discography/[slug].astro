---
import WikiLayout from '../../../layouts/WikiLayout.astro';
import { LANGS, type Lang } from '../../../i18n';
import { slugMeta, slugs, metrics, critic, getDiscographyDetail } from '../../../data/pages/discography-detail';
import lyricsRaw from '../../../content/wiki/lyrics.md?raw';

const base = import.meta.env.BASE_URL;

// --- Lyrics parsing (from lyrics.md — shared, English) ---
function normTitle(t: string): string {
  return t
    .replace(/\(feat[^)]*\)/gi, '')
    .replace(/\([^)]*\)/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]/g, '');
}

type Lyric = { cover: string; body: string };

function parseLyrics(raw: string): Map<string, Lyric> {
  const map = new Map<string, Lyric>();
  let cur: string | null = null;
  let cover = '';
  let buf: string[] = [];
  const flush = () => {
    if (cur) map.set(cur, { cover, body: buf.join('\n').replace(/^\s+|\s+$/g, '') });
    cur = null; cover = ''; buf = [];
  };
  for (const line of raw.split('\n')) {
    const h = line.match(/^###\s+\d+\.\s+(.+)$/);
    if (h) { flush(); cur = normTitle(h[1]); continue; }
    if (line.startsWith('## ')) { flush(); continue; }
    if (!cur) continue;
    const cm = line.match(/^\*\(cover:\s*(.+?)\)\*/i);
    if (cm) { cover = cm[1].trim(); continue; }
    if (line.trim() === '---') continue;
    const note = line.trim().match(/^\*\((.+)\)\*$/);
    if (note) { buf.push(note[1]); continue; }
    buf.push(line);
  }
  flush();
  const alias = (a: string, b: string) => { const v = map.get(a); if (v && !map.has(b)) map.set(b, v); };
  alias('noreservations', 'noreservation');
  alias('idkwhatyoudo', 'idontknowwhatyoudo');
  return map;
}

const lyricsMap = parseLyrics(lyricsRaw);

// --- Per-track detail + Arc (from <lang>/08-summary.md) ---
type TrackMeta = { genre: string; speed: string; mood: string; hook: string };

function parseSummaryTracks(raw: string): Map<string, TrackMeta> {
  const map = new Map<string, TrackMeta>();
  for (const line of raw.split('\n')) {
    const t = line.trim();
    if (!t.startsWith('|')) continue;
    const parts = t.split('|').slice(1, -1).map(c => c.trim());
    if (parts.length !== 6) continue;
    if (!/^\d+$/.test(parts[0])) continue;
    const [, song, genre, speed, mood, hook] = parts;
    map.set(normTitle(song), { genre, speed, mood, hook });
  }
  const alias = (a: string, b: string) => { const v = map.get(a); if (v && !map.has(b)) map.set(b, v); };
  alias('noreservations', 'noreservation');
  alias('idkwhatyoudo', 'idontknowwhatyoudo');
  return map;
}

function parseArc(raw: string, albumTitle: string): string {
  const norm = normTitle(albumTitle);
  const parts = raw.split('\n## ');
  for (const part of parts) {
    const head = part.split('\n')[0];
    const hm = head.match(/^\d+\.\s+(.+?)\s*\((?:19|20)\d\d\)/);
    if (!hm || normTitle(hm[1]) !== norm) continue;
    const lines = part.split('\n');
    const start = lines.findIndex(l => l.trim() === '### Arc');
    if (start === -1) return '';
    const out: string[] = [];
    for (let i = start + 1; i < lines.length; i++) {
      const l = lines[i].trim();
      if (l === '---' || l.startsWith('## ') || l.startsWith('### ')) break;
      if (l) out.push(l);
    }
    return out.join(' ');
  }
  return '';
}

// --- Tracklist parsing (from <lang> album md) ---
type Track = {
  num: number; title: string; isTitle: boolean; isBonus: boolean;
  genre: string; credits: { label: string; value: string }[];
  refArtist: string; refStreams: string;
};

function fmtStreams(refStr: string): { artist: string; streams: string } {
  const match = refStr.match(/^(.+?)\s*\((?:[^,)]+,\s*)?([0-9,]+)\s*streams\)$/);
  if (!match) return { artist: refStr.trim(), streams: '' };
  const n = parseInt(match[2].replace(/,/g, ''));
  const s =
    n >= 1_000_000 ? `${(n / 1_000_000).toFixed(1)}M`
    : n >= 1_000 ? `${(n / 1_000).toFixed(0)}K`
    : n.toLocaleString();
  return { artist: match[1].trim(), streams: s };
}

function parseTracklist(raw: string): Track[] {
  const start = raw.indexOf('Tracklist & Credits');
  if (start === -1) return [];
  const end = raw.indexOf('\nPersonnel', start);
  const section = raw.slice(start, end > -1 ? end : raw.length);
  return section
    .split('\n')
    .filter(l => /^\d+\./.test(l.trim()))
    .map(line => {
      const match = line.match(/^(\d+)\.\s+(.+)$/);
      if (!match) return null;
      const rest = match[2];
      const dashIdx = rest.indexOf(' — ');
      const rawTitle = (dashIdx >= 0 ? rest.slice(0, dashIdx) : rest).trim();
      const afterDash = dashIdx >= 0 ? rest.slice(dashIdx + 3) : '';
      const isTitle = rawTitle.includes('[TITLE]');
      const isBonus = /bonus track|alt\./i.test(rawTitle);
      const title = rawTitle.replace(/\[TITLE\]/gi, '').trim();
      const parts = afterDash.split(' | ');
      const genre = parts[0]?.trim() || '';
      const reference = parts.length > 1 ? parts[parts.length - 1].trim() : '';
      const credits = parts.slice(1, -1)
        .map(p => p.trim())
        .filter(p => /^(Composed|Lyrics|Arranged)\s+by\s/i.test(p))
        .map(p => {
          const m2 = p.match(/^(.+?)\s+by\s+(.+)$/i);
          return m2 ? { label: m2[1].trim(), value: m2[2].trim() } : null;
        })
        .filter((c): c is { label: string; value: string } => c !== null);
      const { artist: refArtist, streams: refStreams } = fmtStreams(reference);
      return { num: parseInt(match[1]), title, isTitle, isBonus, genre, credits, refArtist, refStreams };
    })
    .filter((t): t is Track => t !== null);
}

type DecadeTrack = { title: string; isNew: boolean; isArchive: boolean; archiveNote?: string };
type DecadeDisk = { label: string; tracks: DecadeTrack[] };

function parseDecadeDisks(raw: string): DecadeDisk[] {
  const start = raw.indexOf('Track listing');
  if (start === -1) return [];
  const end = raw.indexOf('\nPersonnel', start);
  const section = raw.slice(start + 'Track listing\n'.length, end > -1 ? end : raw.length);
  const disks: DecadeDisk[] = [];
  let current: DecadeDisk | null = null;
  for (const line of section.split('\n')) {
    const t = line.trim();
    if (!t || t === '</div>') continue;
    if (t.startsWith('Disk ')) {
      if (current) disks.push(current);
      current = { label: t, tracks: [] };
    } else if (current) {
      if (t.startsWith('ARCHIVE')) {
        const am = t.match(/^ARCHIVE [IVX]+: "(.+?)"\s*\(.+?\)\((.+)\)$/);
        current.tracks.push({
          title: am ? `ARCHIVE: "${am[1]}"` : t,
          isArchive: true, isNew: false,
          archiveNote: am ? am[2] : undefined,
        });
      } else {
        current.tracks.push({ title: t, isArchive: false, isNew: t === 'NEW (Title)' || t === 'NEW' });
      }
    }
  }
  if (current) disks.push(current);
  return disks;
}

export function getStaticPaths() {
  return LANGS.flatMap(lang => slugs.map(slug => ({ params: { lang, slug } })));
}

const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug as string;
const L = `${base}${lang}/`;
const d = getDiscographyDetail(lang);
const meta = slugMeta[slug];
const m = metrics[slug];
const cr = critic[slug];
const subtitle = d.subtitle[slug];
const noteText = d.note[slug];

// Load per-language album markdown (Content + raw).
const modules = import.meta.glob('../../../content/wiki/discography/*/*.md');
const rawModules = import.meta.glob('../../../content/wiki/discography/*/*.md', { query: '?raw', import: 'default' });
const key = `../../../content/wiki/discography/${lang}/${meta.file}.md`;
const summaryKey = `../../../content/wiki/discography/${lang}/08-summary.md`;
const mod = await modules[key]() as { Content: any };
const rawText = await rawModules[key]() as string;
const summaryRaw = await rawModules[summaryKey]() as string;
const { Content } = mod;

const trackMeta = parseSummaryTracks(summaryRaw);
const tracks = slug !== 'decade' ? parseTracklist(rawText) : [];
const decadeDisks = slug === 'decade' ? parseDecadeDisks(rawText) : [];
const albumArc = parseArc(summaryRaw, meta.title);

const related = d.related.map(r => ({ label: r.label, href: `${L}${r.slug}` }));
---

<WikiLayout title={meta.title} section={d.ui.section} lang={lang} relatedPages={related}>
  <a href={`${L}discography`} class="inline-flex items-center gap-1.5 text-xs mb-6 transition-colors" style="color:var(--text-muted)">
    {d.ui.back}
  </a>

  <!-- Album header -->
  <div class="flex gap-5 items-start mb-8">
    <div class="w-20 h-20 shrink-0 rounded-xl overflow-hidden relative">
      <img src={`${base}cover/${meta.cover}`} alt={meta.title} class="w-full h-full object-cover" />
      <div class="absolute inset-y-0 left-0 w-1.5" style={`background-color:${meta.color}`}></div>
    </div>
    <div class="flex-1">
      <div class="text-xs font-semibold uppercase tracking-widest mb-1" style={`color:${meta.color}`}>{d.ui.section}</div>
      <h1 class="wiki-title mb-1">{meta.title}</h1>
      <p class="text-sm mb-3" style="color:var(--text-muted)">{subtitle} · {meta.date}</p>
      {cr && (
        <a href={`${L}reception`} class="inline-flex items-center gap-2.5 rounded-lg border px-3 py-1.5 transition-colors critic-badge" style={`border-color:color-mix(in srgb,${meta.color} 35%,var(--border));background-color:color-mix(in srgb,${meta.color} 7%,var(--bg-surface));text-decoration:none`}>
          <span class="text-base font-black leading-none" style={`color:${meta.color}`}>{cr.score}<span class="text-xs font-semibold" style="color:var(--text-faint)">/100</span></span>
          <span class="text-xs" style={`color:${meta.color}`}>{cr.stars}</span>
          <span class="text-xs italic" style="color:var(--text-muted)">"{cr.tag}"</span>
          <span class="text-xs" style="color:var(--text-faint)">{d.ui.criticScoreArrow}</span>
        </a>
      )}
    </div>
  </div>

  <!-- Commercial Metrics Panel -->
  {m && (
    <div class="border rounded-xl p-6 mb-8 space-y-5" style="border-color:var(--border);background-color:var(--bg-surface)">
      <div class="text-xs font-semibold uppercase tracking-widest" style="color:var(--gold)">{d.ui.commercialMetrics}</div>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        <div>
          <div class="text-2xl font-bold" style="color:var(--text)">{m.albumStreams}</div>
          <div class="text-xs text-gray-500 mt-0.5">{d.ui.albumStreamsLabel}</div>
        </div>
        <div>
          <div class="text-sm font-semibold leading-snug">{m.chartPeak}</div>
          <div class="text-xs text-gray-500 mt-0.5">{d.ui.chartPeakLabel}</div>
        </div>
        {m.spotifyPeak && (
          <div>
            <div class="text-sm font-semibold">{m.spotifyPeak}</div>
            <div class="text-xs text-gray-500 mt-0.5">{d.ui.spotifyLabel}</div>
          </div>
        )}
      </div>
      <div class="border-t" style="border-color:var(--border)"></div>
      <div>
        <div class="text-xs text-gray-500 mb-2 uppercase tracking-widest">{d.ui.titleTrackLabel}</div>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-1">
          <span class="text-sm font-semibold">{m.titleTrack.title}</span>
          {m.titleTrack.spotify && (
            <span class="text-xs text-gray-400">Spotify <span class="text-white font-medium">{m.titleTrack.spotify}</span></span>
          )}
          {m.titleTrack.youtube && (
            <span class="text-xs text-gray-400">YouTube <span class="text-white font-medium">{m.titleTrack.youtube}</span></span>
          )}
        </div>
      </div>
      {m.crossover && (
        <div>
          <div class="text-xs text-gray-500 mb-2 uppercase tracking-widest">{d.ui.crossoverLabel}</div>
          <div class="flex flex-wrap items-center gap-x-6 gap-y-1">
            <span class="text-sm font-semibold">{m.crossover.title}</span>
            {m.crossover.spotify && (
              <span class="text-xs text-gray-400">Spotify <span class="text-white font-medium">{m.crossover.spotify}</span></span>
            )}
            {m.crossover.youtube && (
              <span class="text-xs text-gray-400">YouTube <span class="text-white font-medium">{m.crossover.youtube}</span></span>
            )}
          </div>
        </div>
      )}
      {m.keyTracks.length > 0 && (
        <div>
          <div class="text-xs text-gray-500 mb-2 uppercase tracking-widest">{d.ui.keyTracksLabel}</div>
          <div class="flex flex-wrap gap-2">
            {m.keyTracks.map(kt => (
              <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs" style="background-color:var(--bg-muted);border:1px solid var(--border)">
                <span class="text-gray-300">{kt.title}</span>
                <span class="font-semibold" style={`color:${meta.color}`}>{kt.streams}</span>
              </div>
            ))}
          </div>
        </div>
      )}
      {noteText && (
        <div class="text-xs text-gray-500 italic border-l-2 pl-3" style={`border-color:${meta.color}`}>{noteText}</div>
      )}
    </div>
  )}

  <!-- Styled Tracklist — Standard albums -->
  {tracks.length > 0 && (
    <div class="mb-10">
      <div class="flex items-center justify-between mb-3">
        <div class="text-xs font-semibold uppercase tracking-widest" style="color:var(--gold)">{d.ui.tracklist}</div>
        <div class="text-xs text-gray-600">{d.ui.refStreams}</div>
      </div>
      {albumArc && (
        <div class="rounded-lg border-l-2 px-4 py-3 mb-4" style={`border-color:${meta.color};background-color:color-mix(in srgb,${meta.color} 5%,var(--bg-surface))`}>
          <div class="text-xs font-semibold uppercase tracking-widest mb-1" style={`color:${meta.color}`}>{d.ui.albumArc}</div>
          <p class="text-xs leading-relaxed m-0" style="color:var(--text-muted)">{albumArc}</p>
        </div>
      )}
      <div class="rounded-xl overflow-hidden" style="border:1px solid var(--border)">
        {tracks.map((t, i) => {
          const ly = lyricsMap.get(normTitle(t.title));
          const sm = trackMeta.get(normTitle(t.title));
          return (
          <div class={`group ${i !== tracks.length - 1 ? 'border-b' : ''}`} style="border-color:var(--border)">
            <div class="flex items-center gap-4 px-5 py-3 transition-colors hover:bg-white/3">
              <span class="text-gray-700 text-xs font-mono w-4 shrink-0 text-right">{t.num}</span>
              <div class="flex-1 min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <span class={`text-sm font-medium leading-tight ${t.isTitle ? 'text-white' : 'text-gray-200'}`}>
                    {t.title}
                  </span>
                  {t.isTitle && (
                    <span class="text-xs px-1.5 py-0.5 rounded font-bold uppercase tracking-wider" style={`background:${meta.color}22;color:${meta.color};border:1px solid ${meta.color}44`}>
                      {d.ui.titleBadge}
                    </span>
                  )}
                  {t.isBonus && (
                    <span class="text-xs px-1.5 py-0.5 rounded font-semibold uppercase tracking-wider" style="background:var(--bg-muted);color:var(--text-muted);border:1px solid var(--border)">
                      {d.ui.bonusBadge}
                    </span>
                  )}
                </div>
                <div class="text-xs text-gray-600 mt-0.5">{t.genre}</div>
                {sm && (sm.speed || sm.mood) && (
                  <div class="flex flex-wrap gap-1.5 mt-1.5">
                    {sm.speed && sm.speed !== '—' && (
                      <span class="text-xs px-1.5 py-0.5 rounded border" style="border-color:var(--border);color:var(--text-muted)">⏱ {sm.speed}</span>
                    )}
                    {sm.mood && sm.mood !== '—' && (
                      <span class="text-xs px-1.5 py-0.5 rounded" style={`background-color:${meta.color}18;color:${meta.color}`}>{sm.mood}</span>
                    )}
                  </div>
                )}
                {sm && sm.hook && sm.hook !== '—' && (
                  <div class="text-xs italic mt-1" style="color:var(--text-faint)">{d.ui.hookPrefix} · {sm.hook}</div>
                )}
                {t.credits.length > 0 && (
                  <div class="flex flex-wrap gap-x-4 gap-y-0.5 mt-1.5">
                    {t.credits.map(c => (
                      <span class="text-xs text-gray-600">
                        <span class="text-gray-700 font-medium">{c.label}</span>
                        {' '}{c.value}
                      </span>
                    ))}
                  </div>
                )}
              </div>
              <div class="shrink-0 text-right hidden sm:block self-start mt-0.5">
                <div class="text-xs text-gray-600 leading-tight">{t.refArtist}</div>
                {t.refStreams && (
                  <div class="text-xs font-semibold mt-0.5" style={`color:${meta.color}bb`}>{t.refStreams}</div>
                )}
              </div>
            </div>
            {ly && ly.body && (
              <details class="px-5 pb-4 lyrics-details">
                <summary class="text-xs cursor-pointer select-none inline-flex items-center gap-1.5 lyrics-toggle" style={`color:${meta.color}`}>
                  {d.ui.lyricsToggle} · Lyrics
                </summary>
                <div class="mt-3 rounded-lg p-4 text-xs leading-relaxed" style="background:var(--bg-muted);color:var(--text-muted);white-space:pre-line">{ly.body.replace(/ \/ /g, '\n')}</div>
                {ly.cover && (
                  <div class="text-xs mt-2" style="color:var(--text-faint)">{d.ui.referenceVocal} · {ly.cover}</div>
                )}
              </details>
            )}
          </div>
          );
        })}
      </div>
    </div>
  )}

  <!-- Styled Tracklist — DECADE disk structure -->
  {decadeDisks.length > 0 && (
    <div class="mb-10">
      <div class="text-xs font-semibold uppercase tracking-widest mb-4" style="color:var(--gold)">{d.ui.trackListing}</div>
      {albumArc && (
        <div class="rounded-lg border-l-2 px-4 py-3 mb-4" style={`border-color:${meta.color};background-color:color-mix(in srgb,${meta.color} 5%,var(--bg-surface))`}>
          <div class="text-xs font-semibold uppercase tracking-widest mb-1" style={`color:${meta.color}`}>{d.ui.albumArc}</div>
          <p class="text-xs leading-relaxed m-0" style="color:var(--text-muted)">{albumArc}</p>
        </div>
      )}
      <div class="space-y-6">
        {decadeDisks.map(disk => (
          <div class="rounded-xl overflow-hidden" style="border:1px solid var(--border)">
            <div class="px-5 py-3 border-b" style={`background:${meta.color}18;border-color:var(--border)`}>
              <span class="text-xs font-bold uppercase tracking-widest" style={`color:${meta.color}`}>{disk.label}</span>
            </div>
            <div>
              {(() => {
                let trackNum = 0;
                return disk.tracks.map((t, i) => {
                  if (!t.isArchive) trackNum++;
                  return t.isArchive ? (
                    <div class={`flex gap-3 px-5 py-3 ${i !== disk.tracks.length - 1 ? 'border-b' : ''}`}
                      style="background:var(--bg);border-color:var(--border)">
                      <span class="text-xs mt-0.5 shrink-0" style={`color:${meta.color}88`}>◈</span>
                      <div>
                        <div class="text-xs font-medium text-gray-500 italic">{t.title}</div>
                        {t.archiveNote && (
                          <div class="text-xs text-gray-700 mt-0.5">{t.archiveNote}</div>
                        )}
                      </div>
                    </div>
                  ) : (
                    <div class={`flex items-center gap-4 px-5 py-3 hover:bg-white/3 transition-colors ${i !== disk.tracks.length - 1 ? 'border-b' : ''}`}
                      style="border-color:var(--border)">
                      <span class="text-gray-700 text-xs font-mono w-4 shrink-0 text-right">{trackNum}</span>
                      <span class="text-sm text-gray-200 flex-1">{t.title}</span>
                      {t.isNew && (
                        <span class="text-xs px-1.5 py-0.5 rounded font-bold uppercase tracking-wider shrink-0" style={`background:${meta.color}22;color:${meta.color};border:1px solid ${meta.color}44`}>
                          {d.ui.newBadge}
                        </span>
                      )}
                    </div>
                  );
                });
              })()}
            </div>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- Album background & context -->
  <div class="border-t pt-8 mt-2" style="border-color:var(--border)">
    <div class="text-xs font-semibold uppercase tracking-widest mb-6" style="color:var(--gold)">{d.ui.albumNotes}</div>
    <div class="prose prose-invert max-w-none album-prose">
      <Content />
    </div>
  </div>
</WikiLayout>

<style>
  :global(.raw-tracklist) { display: none; }
  :global(.album-prose > h2:first-child) { display: none; }
  :global(.album-prose h3) {
    font-size: 0.75rem;
    margin-top: 1.5rem !important;
    margin-bottom: 0.5rem !important;
  }
  :global(.album-prose p) {
    font-size: 0.875rem;
    line-height: 1.75;
    margin-top: 0.5rem !important;
    margin-bottom: 0.5rem !important;
  }
  :global(.album-prose li) {
    font-size: 0.875rem;
    line-height: 1.7;
  }
  :global(.album-prose ul) {
    margin-top: 0.4rem !important;
    margin-bottom: 0.4rem !important;
  }
  :global(.album-prose strong) {
    color: var(--text);
  }
  :global(.album-prose p:has(strong:first-child)) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: baseline;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
    padding-bottom: 0.25rem;
    margin-bottom: 0.25rem !important;
  }
  :global(.album-prose p:has(strong:first-child) br) {
    flex-basis: 100%;
    height: 0;
  }
  .lyrics-details summary { list-style: none; }
  .lyrics-details summary::-webkit-details-marker { display: none; }
  .lyrics-details summary::before { content: '▸ '; }
  .lyrics-details[open] summary::before { content: '▾ '; }
  :global(.album-prose pre) {
    background-color: var(--bg-muted) !important;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    font-size: 0.78rem;
    line-height: 1.7;
    color: var(--text-muted) !important;
  }
</style>
