---
import WikiLayout from '../../layouts/WikiLayout.astro';
import { langStaticPaths, type Lang } from '../../i18n';
import { getFashion } from '../../data/pages/fashion';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = Astro.params.lang as Lang;
const base = import.meta.env.BASE_URL;
const d = getFashion(lang);

const relatedLabels = {
  discography: { en: 'Discography', th: 'ผลงานเพลง' },
  musicVideos: { en: 'Music Videos', th: 'มิวสิกวิดีโอ' },
  tours: { en: 'Tours', th: 'ทัวร์คอนเสิร์ต' },
  ecosystem: { en: 'Endorsements', th: 'พรีเซ็นเตอร์ & ดีล' },
  publicImage: { en: 'Public Image', th: 'ภาพลักษณ์สาธารณะ' },
};
const related = [
  { label: relatedLabels.discography[lang], href: `${base}${lang}/discography` },
  { label: relatedLabels.musicVideos[lang], href: `${base}${lang}/music-videos` },
  { label: relatedLabels.tours[lang], href: `${base}${lang}/tours` },
  { label: relatedLabels.ecosystem[lang], href: `${base}${lang}/ecosystem` },
  { label: relatedLabels.publicImage[lang], href: `${base}${lang}/public-image` },
];
---
<WikiLayout title={d.ui.title} section="Biography" lang={lang} relatedPages={related}>
  <div class="mb-8">
    <div class="wiki-label mb-2">{d.ui.label}</div>
    <h1 class="wiki-title mb-2">{d.ui.title}</h1>
    <p class="text-sm" style="color:var(--text-muted)">{d.ui.subtitle}</p>
  </div>

  <div class="rounded-lg border px-5 py-4 mb-10 text-sm leading-relaxed" style="border-color:var(--border);background-color:var(--bg-surface);color:var(--text-muted)">
    {d.ui.intro}
  </div>

  <!-- Era breakdown -->
  <section class="mb-12 space-y-8">
    {d.eras.map(era => (
      <div class="rounded-xl border overflow-hidden" style={`border-color:color-mix(in srgb,${era.color} 30%,var(--border))`}>
        <!-- Era header -->
        <div class="px-5 py-3 flex items-center gap-3" style={`background-color:color-mix(in srgb,${era.color} 8%,var(--bg-surface))`}>
          <div class="w-3 h-3 rounded-full shrink-0" style={`background-color:${era.color}`}></div>
          <span class="font-black text-base tracking-wide" style={`color:${era.color}`}>{era.era}</span>
          <span class="text-xs font-mono" style="color:var(--text-muted)">{era.period}</span>
          <span class="text-xs ml-auto" style="color:var(--text-muted)">{era.label}</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-0 divide-y md:divide-y-0 md:divide-x" style="border-color:color-mix(in srgb,var(--border) 60%,transparent)">
          <!-- Album aesthetic -->
          <div class="px-5 py-4" style="background-color:var(--bg-surface)">
            <div class="text-xs font-semibold uppercase tracking-widest mb-2" style={`color:${era.color}`}>{d.ui.albumAestheticLabel}</div>
            <p class="text-sm leading-relaxed" style="color:var(--text-muted)">{era.albumAesthetic}</p>
          </div>
          <!-- Stage wardrobe -->
          <div class="px-5 py-4" style="background-color:var(--bg-surface)">
            <div class="text-xs font-semibold uppercase tracking-widest mb-2" style={`color:${era.color}`}>{d.ui.stageWardrobeLabel}</div>
            <p class="text-sm leading-relaxed" style="color:var(--text-muted)">{era.stageWardrobe}</p>
          </div>
        </div>

        <!-- Key pieces + designers row -->
        <div class="px-5 py-3 flex flex-wrap gap-x-8 gap-y-3 border-t" style={`border-color:color-mix(in srgb,var(--border) 60%,transparent);background-color:color-mix(in srgb,${era.color} 4%,var(--bg-surface))`}>
          <div class="flex-1 min-w-48">
            <div class="text-xs font-semibold uppercase tracking-widest mb-1.5" style="color:var(--text-muted)">{d.ui.keyPiecesLabel}</div>
            <div class="flex flex-wrap gap-1.5">
              {era.keyPieces.map(p => (
                <span class="text-xs px-2 py-0.5 rounded" style={`background-color:color-mix(in srgb,${era.color} 10%,transparent);color:${era.color}`}>{p}</span>
              ))}
            </div>
          </div>
          {era.designers.length > 0 && (
            <div class="flex-1 min-w-48">
              <div class="text-xs font-semibold uppercase tracking-widest mb-1.5" style="color:var(--text-muted)">{d.ui.collaboratingLabel}</div>
              <div class="flex flex-wrap gap-1.5">
                {era.designers.map(des => (
                  <span class="text-xs px-2 py-0.5 rounded border" style={`border-color:color-mix(in srgb,${era.color} 30%,transparent);color:var(--text-muted)`}>{des}</span>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Context note -->
        <div class="px-5 py-3 border-t text-xs leading-relaxed italic" style={`border-color:color-mix(in srgb,var(--border) 60%,transparent);background-color:var(--bg-surface);color:var(--text-muted)`}>
          {era.context}
        </div>
      </div>
    ))}
  </section>

  <!-- Key designer relationships -->
  <section class="mb-10">
    <h2 class="wiki-section mb-4">{d.ui.designersHeading}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {d.designers.map(des => (
        <div class="rounded-lg border px-5 py-4" style="border-color:var(--border);background-color:var(--bg-surface)">
          <div class="flex items-baseline gap-3 mb-1">
            <span class="font-bold text-base" style="color:var(--gold)">{des.name}</span>
            <span class="text-xs" style="color:var(--text-muted)">{des.rep} · {des.period}</span>
          </div>
          <div class="text-xs font-semibold uppercase tracking-wide mb-2" style="color:var(--text-muted)">{d.ui.originLabel}</div>
          <p class="text-sm leading-relaxed mb-3" style="color:var(--text-muted)">{des.origin}</p>
          <div class="text-xs font-semibold uppercase tracking-wide mb-1" style="color:var(--text-muted)">{d.ui.workTogetherLabel}</div>
          <p class="text-sm leading-relaxed mb-3" style="color:var(--text-muted)">{des.work}</p>
          <div class="text-xs leading-relaxed px-3 py-2 rounded" style="background-color:var(--bg-muted);color:var(--text-muted)">
            <span class="font-semibold" style="color:var(--text)">{d.ui.significanceLabel}</span>{des.significance}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Tour as visual identity note -->
  <section class="mb-10">
    <h2 class="wiki-section mb-4">{d.ui.tourHeading}</h2>
    <div class="space-y-3">
      {d.tourNotes.map(t => (
        <div class="rounded-lg border px-5 py-4 flex gap-4" style={`border-color:color-mix(in srgb,${t.color} 25%,var(--border));background-color:var(--bg-surface)`}>
          <div class="w-2 rounded-full shrink-0 self-stretch" style={`background-color:${t.color};opacity:0.5`}></div>
          <div>
            <div class="font-bold text-sm mb-1.5" style={`color:${t.color}`}>{t.tour}</div>
            <p class="text-sm leading-relaxed" style="color:var(--text-muted)">{t.note}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
</WikiLayout>
