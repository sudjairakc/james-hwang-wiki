---
import WikiLayout from '../../layouts/WikiLayout.astro';
import { langStaticPaths, type Lang } from '../../i18n';
import { getProductionCredits, linaProject } from '../../data/pages/production-credits';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = Astro.params.lang as Lang;
const base = import.meta.env.BASE_URL;
const d = getProductionCredits(lang);

const relatedLabels = {
  discography: { en: 'Discography', th: 'ผลงานเพลง' },
  collaborations: { en: 'Collaborations', th: 'คอลแลบ' },
  canon: { en: 'Canon', th: 'แคนอน' },
  biography: { en: 'Biography', th: 'ชีวประวัติ' },
};
const related = [
  { label: relatedLabels.discography[lang], href: `${base}${lang}/discography` },
  { label: relatedLabels.collaborations[lang], href: `${base}${lang}/collaborations` },
  { label: relatedLabels.canon[lang], href: `${base}${lang}/canon` },
  { label: relatedLabels.biography[lang], href: `${base}${lang}/biography` },
];

// Group credits by year for display
const years = [...new Set(d.credits.map(c => c.year))];
---

<WikiLayout title={d.ui.title} section="Discography" lang={lang} relatedPages={related}>

  <div class="mb-8">
    <div class="text-xs font-semibold uppercase tracking-widest mb-1" style="color:var(--gold)">{d.ui.label}</div>
    <h1 class="wiki-title mb-3">{d.ui.title}</h1>
    <p class="text-sm leading-relaxed max-w-2xl" style="color:var(--text-muted)" set:html={d.ui.introHtml}></p>
  </div>

  <!-- L.I.N.A. Project -->
  <section class="mb-12">
    <div class="flex items-center gap-4 mb-5">
      <img src={`${base}cover/lina.png`} alt="L.I.N.A." class="w-14 h-14 rounded-lg object-cover shrink-0" />
      <div class="flex items-center gap-3 flex-wrap">
        <h2 class="text-base font-bold" style="color:var(--text)">{d.ui.linaHeading}</h2>
        <span class="text-xs px-2 py-0.5 rounded font-semibold" style="background-color:color-mix(in srgb,var(--gold) 12%,transparent);color:var(--gold)">{linaProject.released}</span>
      </div>
    </div>

    <!-- Credits block -->
    <div class="rounded-xl border overflow-hidden mb-5" style="border-color:var(--border)">
      <div class="px-4 py-2.5 border-b text-xs font-semibold uppercase tracking-widest" style="color:var(--gold);border-color:var(--border);background-color:color-mix(in srgb,var(--gold) 5%,var(--bg-surface))">{d.ui.projectCreditsHeader}</div>
      <div style="background-color:var(--bg-surface)">
        {[
          { label: d.ui.producedByLabel, val: linaProject.producedBy },
          { label: d.ui.musicByLabel, val: linaProject.musicBy },
          { label: d.ui.lyricsByLabel, val: linaProject.lyricBy },
          { label: d.ui.arrangedByLabel, val: linaProject.arrangedBy },
          { label: d.ui.platformLabel, val: linaProject.platform },
        ].map((r, i, arr) => (
          <div class="flex gap-4 px-4 py-2" style={i < arr.length - 1 ? 'border-bottom:1px solid color-mix(in srgb,var(--border) 40%,transparent)' : ''}>
            <div class="text-xs font-semibold w-28 shrink-0 mt-0.5" style="color:var(--text-muted)">{r.label}</div>
            <div class="text-sm" style="color:var(--text)">{r.val}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- Tracks -->
    <div class="space-y-3">
      {linaProject.tracks.map(track => (
        <div class="rounded-xl border overflow-hidden" style="border-color:var(--border)">
          <div class="flex items-center gap-3 px-4 py-3 border-b" style="border-color:var(--border);background-color:var(--bg-surface)">
            <span class="w-6 h-6 rounded-full flex items-center justify-center text-xs font-black shrink-0" style="background-color:color-mix(in srgb,var(--gold) 15%,transparent);color:var(--gold)">{track.num}</span>
            <div class="flex-1 min-w-0">
              <span class="text-sm font-bold" style="color:var(--text)">{track.title}</span>
              <span class="text-xs ml-2" style="color:var(--text-muted)">{d.ui.performedByPrefix} {track.performer}</span>
            </div>
            <div class="text-right shrink-0">
              <div class="text-xs font-mono font-semibold" style="color:var(--gold)">{track.streams}</div>
              <div class="text-xs" style="color:var(--text-faint)">{d.ui.streamsLabel}</div>
            </div>
          </div>
          <div class="px-4 py-2.5" style="background-color:var(--bg)">
            <div class="text-xs font-semibold uppercase tracking-widest mb-1.5" style="color:var(--text-muted)">{d.ui.featuredLabel}</div>
            <div class="flex flex-wrap gap-1.5">
              {track.feat.map(f => (
                <span class="text-xs px-2 py-0.5 rounded border" style="border-color:var(--border);color:var(--text-muted);background-color:var(--bg-surface)">{f}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- External Credits Table -->
  <section>
    <h2 class="text-base font-bold mb-5" style="color:var(--text)">{d.ui.externalHeading}</h2>

    {years.map(year => {
      const yearCredits = d.credits.filter(c => c.year === year);
      return (
        <div class="mb-8">
          <div class="text-xs font-semibold uppercase tracking-widest mb-3 flex items-center gap-2" style="color:var(--gold)">
            <span>{year}</span>
            <div class="flex-1 h-px" style="background-color:color-mix(in srgb,var(--border) 60%,transparent)"></div>
          </div>
          <div class="rounded-xl border overflow-hidden" style="border-color:var(--border)">
            <!-- Header -->
            <div class="grid text-xs font-semibold uppercase tracking-widest px-4 py-2 border-b" style="grid-template-columns:2fr 1fr 2fr 2fr 1.5fr;color:var(--text-muted);border-color:var(--border);background-color:color-mix(in srgb,var(--gold) 4%,var(--bg-surface))">
              <div>{d.ui.tableTitleArtist}</div>
              <div>{d.ui.tableGroup}</div>
              <div>{d.ui.tableComposed}</div>
              <div>{d.ui.tableArranged}</div>
              <div>{d.ui.tableNote}</div>
            </div>
            {yearCredits.map((c, i) => (
              <div class="grid items-start px-4 py-3 text-sm" style={`grid-template-columns:2fr 1fr 2fr 2fr 1.5fr;background-color:var(--bg-surface);${i < yearCredits.length - 1 ? 'border-bottom:1px solid color-mix(in srgb,var(--border) 40%,transparent)' : ''}`}>
                <div>
                  <div class="font-semibold" style="color:var(--text)">{c.title}</div>
                  <div class="text-xs mt-0.5" style="color:var(--text-muted)">{c.artist}</div>
                </div>
                <div class="text-xs" style="color:var(--text-muted)">{c.artistGroup}</div>
                <div class="text-xs leading-relaxed" style="color:var(--text-muted)">{c.composed.join(' · ')}</div>
                <div class="text-xs leading-relaxed" style="color:var(--text-muted)">{c.arranged.join(' · ')}</div>
                <div class="text-xs" style="color:var(--text-faint)">{c.remark || '—'}</div>
              </div>
            ))}
          </div>
        </div>
      );
    })}
  </section>

</WikiLayout>
