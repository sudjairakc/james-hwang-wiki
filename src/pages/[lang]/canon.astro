---
import WikiLayout from '../../layouts/WikiLayout.astro';
import { langStaticPaths, type Lang } from '../../i18n';
import { getCanon, rangeChart, danceRadar, prodRadar, personalityRadar, subRadars, sopaFriends, liner98 } from '../../data/pages/canon';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = Astro.params.lang as Lang;
const base = import.meta.env.BASE_URL;
const d = getCanon(lang);

const relatedLabels = {
  cultural: { en: 'Cultural Impact', th: 'อิทธิพลเชิงวัฒนธรรม' },
  public: { en: 'Public Image', th: 'ภาพลักษณ์สาธารณะ' },
  discography: { en: 'Discography', th: 'ผลงานเพลง' },
  filmography: { en: 'Filmography', th: 'ผลงานภาพยนตร์' },
  timeline: { en: 'Career Timeline', th: 'ไทม์ไลน์อาชีพ' },
};
const related = [
  { label: relatedLabels.cultural[lang], href: `${base}${lang}/cultural-impact` },
  { label: relatedLabels.public[lang], href: `${base}${lang}/public-image` },
  { label: relatedLabels.discography[lang], href: `${base}${lang}/discography` },
  { label: relatedLabels.filmography[lang], href: `${base}${lang}/filmography` },
  { label: relatedLabels.timeline[lang], href: `${base}${lang}/timeline` },
];
---
<WikiLayout title={d.ui.title} section="Reference" lang={lang} relatedPages={related}>
  <div class="mb-8">
    <div class="wiki-label mb-2">{d.ui.label}</div>
    <h1 class="wiki-title mb-2">{d.ui.title}</h1>
    <p class="text-sm" style="color:var(--text-muted)">{d.ui.subtitle}</p>
  </div>

  <!-- Quick identity -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-10">
    {d.identity.map(f => (
      <div class="stat-card">
        <div class="text-xs font-semibold uppercase tracking-widest mb-1" style="color:var(--text-muted)">{f.label}</div>
        <div class="text-sm font-bold leading-snug">{f.val}</div>
      </div>
    ))}
  </div>

  <!-- ── VOCAL ── -->
  <section class="mb-10">
    <h2 class="wiki-section mb-5">{d.ui.vocalHeading}</h2>

    <!-- Range stats -->
    <div class="grid grid-cols-3 gap-3 mb-6">
      {d.vocalStats.map(s => (
        <div class="stat-card text-center">
          <div class="stat-val text-xl">{s.val}</div>
          <div class="stat-label">{s.label}</div>
        </div>
      ))}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Features -->
      <div>
        <div class="text-xs font-semibold uppercase tracking-widest mb-3" style="color:var(--text-muted)">{d.ui.keyFeaturesLabel}</div>
        <div class="rounded-lg border overflow-hidden" style="border-color:var(--border)">
          {d.vocalFeatures.map((f, i, arr) => (
            <div class="flex gap-3 px-4 py-2.5" style={`background-color:var(--bg-surface);${i < arr.length - 1 ? 'border-bottom:1px solid color-mix(in srgb, var(--border) 50%, transparent)' : ''}`}>
              <span class="text-xs font-bold w-28 shrink-0 pt-0.5" style="color:var(--gold)">{f.feat}</span>
              <span class="text-sm" style="color:var(--text-muted)">{f.desc}</span>
            </div>
          ))}
        </div>
      </div>
      <!-- Techniques -->
      <div>
        <div class="text-xs font-semibold uppercase tracking-widest mb-3" style="color:var(--text-muted)">{d.ui.styleAdjustLabel}</div>
        <div class="rounded-lg border overflow-hidden" style="border-color:var(--border)">
          {d.vocalTechniques.map((t, i, arr) => (
            <div class="flex gap-3 px-4 py-2.5" style={`background-color:var(--bg-surface);${i < arr.length - 1 ? 'border-bottom:1px solid color-mix(in srgb, var(--border) 50%, transparent)' : ''}`}>
              <span class="text-xs font-bold w-32 shrink-0 pt-0.5" style="color:var(--gold)">{t.tech}</span>
              <span class="text-sm" style="color:var(--text-muted)">{t.desc}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Vocal range chart -->
    <div class="mt-6">
      <div class="text-xs font-semibold uppercase tracking-widest mb-1" style="color:var(--text-muted)">{d.ui.rangeComparisonLabel}</div>
      <p class="text-xs mb-3" style="color:var(--text-faint)">{d.ui.rangeComparisonIntro}</p>
      <div class="rounded-lg border overflow-hidden p-4" style="border-color:var(--border);background-color:var(--bg-surface)">
        <canvas id="rangeChart" height="160" style="width:100%;display:block"></canvas>
        <!-- legend -->
        <div class="flex flex-wrap gap-x-5 gap-y-2 mt-4">
          <div class="flex items-center gap-2"><span class="inline-block w-8 h-2.5 rounded" style="background-color:#c9a84c55;border:1.5px solid #c9a84c"></span><span class="text-xs font-semibold" style="color:#c9a84c">James Hwang</span></div>
          <div class="flex items-center gap-2"><span class="inline-block w-8 h-2.5 rounded" style="background-color:#60a5fa44;border:1.5px solid #60a5fa"></span><span class="text-xs font-semibold" style="color:#60a5fa">K-Male Idol (avg)</span></div>
          <div class="flex items-center gap-2"><span class="inline-block w-8 h-2.5 rounded" style="background-color:#6b728044;border:1.5px solid #6b7280"></span><span class="text-xs font-semibold" style="color:#9ca3af">Global Male Singer (avg)</span></div>
          <div class="flex items-center gap-2"><span class="inline-block w-8 h-1 rounded" style="background-color:#c9a84c;opacity:0.4"></span><span class="text-xs" style="color:var(--text-faint)">Power Core (G3–E4)</span></div>
        </div>
      </div>
    </div>

    <!-- Vocal refs -->
    <div class="mt-6">
      <div class="text-xs font-semibold uppercase tracking-widest mb-3" style="color:var(--text-muted)">{d.ui.referenceArtistsLabel}</div>
      <div class="flex flex-wrap gap-2">
        {d.vocalRefs.map(r => (
          <div class="flex items-center gap-2.5 px-3 py-2 rounded-lg border" style="border-color:var(--border);background-color:var(--bg-surface)">
            <span class="text-sm font-bold">{r.artist}</span>
            <span class="text-xs" style="color:var(--text-muted)">{r.area}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Vibrato + Resonance -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
      <div>
        <div class="text-xs font-semibold uppercase tracking-widest mb-3" style="color:var(--text-muted)">{d.ui.vibratoProfileLabel}</div>
        <div class="rounded-lg border overflow-hidden" style="border-color:var(--border)">
          {d.vibratoProfile.map((r, i, arr) => (
            <div class="flex gap-3 px-4 py-2.5" style={`background-color:var(--bg-surface);${i < arr.length - 1 ? 'border-bottom:1px solid color-mix(in srgb, var(--border) 50%, transparent)' : ''}`}>
              <span class="text-xs font-bold w-24 shrink-0 pt-0.5" style="color:var(--gold)">{r.attr}</span>
              <span class="text-sm" style="color:var(--text-muted)">{r.val}</span>
            </div>
          ))}
        </div>
      </div>
      <div>
        <div class="text-xs font-semibold uppercase tracking-widest mb-3" style="color:var(--text-muted)">{d.ui.resonanceRegisterLabel}</div>
        <div class="rounded-lg border overflow-hidden" style="border-color:var(--border)">
          {d.resonanceRegister.map((r, i, arr) => (
            <div class="flex gap-3 px-4 py-2.5" style={`background-color:var(--bg-surface);${i < arr.length - 1 ? 'border-bottom:1px solid color-mix(in srgb, var(--border) 50%, transparent)' : ''}`}>
              <span class="text-xs font-bold w-32 shrink-0 pt-0.5" style="color:var(--gold)">{r.attr}</span>
              <span class="text-sm" style="color:var(--text-muted)">{r.val}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Vibrato waveform chart -->
    <div class="mt-4 rounded-lg border p-4" style="border-color:var(--border);background-color:var(--bg-surface)">
      <div class="text-xs font-semibold uppercase tracking-widest mb-3" style="color:var(--text-muted)">{d.ui.vibratoWaveHeading}</div>
      <canvas id="vibratoWave" height="70" style="width:100%;display:block"></canvas>
    </div>

    <!-- Onset + Dynamic -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
      <div>
        <div class="text-xs font-semibold uppercase tracking-widest mb-3" style="color:var(--text-muted)">{d.ui.onsetArticulationLabel}</div>
        <div class="rounded-lg border overflow-hidden" style="border-color:var(--border)">
          {d.onsetArticulation.map((r, i, arr) => (
            <div class="flex gap-3 px-4 py-2.5" style={`background-color:var(--bg-surface);${i < arr.length - 1 ? 'border-bottom:1px solid color-mix(in srgb, var(--border) 50%, transparent)' : ''}`}>
              <span class="text-xs font-bold w-32 shrink-0 pt-0.5" style="color:var(--gold)">{r.attr}</span>
              <span class="text-sm" style="color:var(--text-muted)">{r.val}</span>
            </div>
          ))}
        </div>
      </div>
      <div>
        <div class="text-xs font-semibold uppercase tracking-widest mb-3" style="color:var(--text-muted)">{d.ui.dynamicSustainLabel}</div>
        <div class="rounded-lg border overflow-hidden" style="border-color:var(--border)">
          {d.dynamicSustain.map((r, i, arr) => (
            <div class="flex gap-3 px-4 py-2.5" style={`background-color:var(--bg-surface);${i < arr.length - 1 ? 'border-bottom:1px solid color-mix(in srgb, var(--border) 50%, transparent)' : ''}`}>
              <span class="text-xs font-bold w-28 shrink-0 pt-0.5" style="color:var(--gold)">{r.attr}</span>
              <span class="text-sm" style="color:var(--text-muted)">{r.val}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Dynamic range chart -->
    <div class="mt-4 rounded-lg border p-4" style="border-color:var(--border);background-color:var(--bg-surface)">
      <div class="text-xs font-semibold uppercase tracking-widest mb-3" style="color:var(--text-muted)">{d.ui.dynamicRangeHeading}</div>
      <canvas id="dynamicRange" height="56" style="width:100%;display:block"></canvas>
    </div>
  </section>

  <!-- ── PRODUCTION ── -->
  <section class="mb-10">
    <h2 class="wiki-section mb-5">{d.ui.productionHeading}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-4">
      {d.productionDNA.map(p => (
        <div class="flex gap-3 px-4 py-3 rounded-lg border" style="border-color:var(--border);background-color:var(--bg-surface)">
          <span class="text-xs font-bold w-28 shrink-0 pt-0.5 leading-snug" style="color:var(--gold)">{p.elem}</span>
          <span class="text-sm leading-relaxed" style="color:var(--text-muted)">{p.desc}</span>
        </div>
      ))}
    </div>
    <!-- Production radar -->
    <div class="flex flex-col md:flex-row gap-6 items-center mb-6">
      <div class="shrink-0 mx-auto">
        <canvas id="prodRadarChart" width="260" height="260"></canvas>
      </div>
      <div class="flex-1">
        <div class="flex items-center gap-5 mb-4 flex-wrap">
          {prodRadar.datasets.map(ds => (
            <div class="flex items-center gap-2">
              <span class="inline-block w-6 h-0.5 rounded" style={`background-color:${ds.color}`}></span>
              <span class="text-xs font-semibold" style={`color:${ds.color}`}>{ds.name}</span>
            </div>
          ))}
        </div>
        <div class="grid grid-cols-1 gap-2">
          {prodRadar.axes.map((axis, i) => (
            <div class="flex items-center gap-3">
              <span class="text-xs w-36 shrink-0" style="color:var(--text-muted)">{axis}</span>
              <div class="flex-1 flex items-center gap-2">
                {prodRadar.datasets.map(ds => (
                  <div class="flex items-center gap-1">
                    <div class="h-1.5 rounded-full" style={`width:${ds.scores[i] * 8}px;background-color:${ds.color}99`}></div>
                    <span class="text-xs font-bold" style={`color:${ds.color}`}>{ds.scores[i]}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="text-xs font-semibold uppercase tracking-widest mb-3" style="color:var(--text-muted)">{d.ui.producerRefsLabel}</div>
    <div class="flex flex-wrap gap-2">
      {d.productionRefs.map(r => (
        <div class="flex items-center gap-2.5 px-3 py-2 rounded-lg border" style="border-color:var(--border);background-color:var(--bg-surface)">
          <span class="text-sm font-bold">{r.producer}</span>
          <span class="text-xs" style="color:var(--text-muted)">{r.area}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ── DANCE ── -->
  <section class="mb-10">
    <h2 class="wiki-section mb-5">{d.ui.danceHeading}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
      <!-- Style grid -->
      <div>
        <div class="text-xs font-semibold uppercase tracking-widest mb-3" style="color:var(--text-muted)">{d.ui.styleBreakdownLabel}</div>
        <div class="rounded-lg border overflow-hidden" style="border-color:var(--border)">
          {d.danceStyle.map((ds, i, arr) => (
            <div class="flex gap-3 px-4 py-2.5" style={`background-color:var(--bg-surface);${i < arr.length - 1 ? 'border-bottom:1px solid color-mix(in srgb, var(--border) 50%, transparent)' : ''}`}>
              <span class="text-xs font-bold w-32 shrink-0 pt-0.5" style={`color:${ds.cat === 'Limitation' || ds.cat === 'ข้อจำกัด' ? '#f87171' : 'var(--gold)'}`}>{ds.cat}</span>
              <span class="text-sm" style="color:var(--text-muted)">{ds.val}</span>
            </div>
          ))}
        </div>
      </div>
      <!-- Compare table -->
      <div>
        <div class="text-xs font-semibold uppercase tracking-widest mb-3" style="color:var(--text-muted)">{d.ui.vsContemporariesLabel}</div>
        <div class="rounded-lg border overflow-hidden" style="border-color:var(--border)">
          <div class="grid grid-cols-4 px-3 py-2" style="background-color:color-mix(in srgb, var(--gold) 8%, var(--bg-surface));border-bottom:1px solid var(--gold)">
            {[d.ui.compareHeaderAspect, 'Taeyong', 'Mark', 'James'].map(h => (
              <div class="text-xs font-semibold uppercase tracking-widest" style="color:var(--gold)">{h}</div>
            ))}
          </div>
          {d.danceCompare.map((row, i, arr) => (
            <div class="grid grid-cols-4 px-3 py-2.5 text-sm" style={`background-color:var(--bg-surface);${i < arr.length - 1 ? 'border-bottom:1px solid color-mix(in srgb, var(--border) 50%, transparent)' : ''}`}>
              <div class="text-xs font-semibold" style="color:var(--text-muted)">{row.aspect}</div>
              <div style="color:var(--text-muted)">{row.taeyong}</div>
              <div style="color:var(--text-muted)">{row.mark}</div>
              <div class="font-semibold">{row.james}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
    <!-- Dance compare radar -->
    <div class="flex flex-col md:flex-row gap-6 items-center mb-6">
      <div class="shrink-0 mx-auto">
        <canvas id="danceRadarChart" width="260" height="260"></canvas>
      </div>
      <div class="flex-1">
        <div class="flex items-center gap-5 mb-4 flex-wrap">
          {danceRadar.dancers.map(dc => (
            <div class="flex items-center gap-2">
              <span class="inline-block w-6 h-0.5 rounded" style={`background-color:${dc.color}`}></span>
              <span class="text-xs font-semibold" style={`color:${dc.color}`}>{dc.name}</span>
            </div>
          ))}
        </div>
        <div class="grid grid-cols-1 gap-2">
          {danceRadar.axes.map((axis, i) => (
            <div class="flex items-center gap-3">
              <span class="text-xs w-36 shrink-0" style="color:var(--text-muted)">{axis}</span>
              <div class="flex-1 flex items-center gap-3">
                {danceRadar.dancers.map(dc => (
                  <div class="flex items-center gap-1">
                    <div class="h-1.5 rounded-full" style={`width:${dc.scores[i] * 8}px;background-color:${dc.color}99`}></div>
                    <span class="text-xs font-bold" style={`color:${dc.color}`}>{dc.scores[i]}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Dance refs -->
    <div class="text-xs font-semibold uppercase tracking-widest mb-3" style="color:var(--text-muted)">{d.ui.referenceArtistsLabel}</div>
    <div class="flex flex-wrap gap-2 mb-6">
      {d.danceRefs.map(r => (
        <div class="flex items-center gap-2.5 px-3 py-2 rounded-lg border" style="border-color:var(--border);background-color:var(--bg-surface)">
          <span class="text-sm font-bold">{r.artist}</span>
          <span class="text-xs" style="color:var(--text-muted)">{r.area}</span>
        </div>
      ))}
    </div>

    <!-- Timing + Spatial -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
      <div>
        <div class="text-xs font-semibold uppercase tracking-widest mb-3" style="color:var(--text-muted)">{d.ui.timingWeightLabel}</div>
        <div class="rounded-lg border overflow-hidden" style="border-color:var(--border)">
          {d.danceTimingWeight.map((r, i, arr) => (
            <div class="flex gap-3 px-4 py-2.5" style={`background-color:var(--bg-surface);${i < arr.length - 1 ? 'border-bottom:1px solid color-mix(in srgb, var(--border) 50%, transparent)' : ''}`}>
              <span class="text-xs font-bold w-32 shrink-0 pt-0.5" style="color:var(--gold)">{r.attr}</span>
              <span class="text-sm" style="color:var(--text-muted)">{r.val}</span>
            </div>
          ))}
        </div>
      </div>
      <div>
        <div class="text-xs font-semibold uppercase tracking-widest mb-3" style="color:var(--text-muted)">{d.ui.spatialTransitionLabel}</div>
        <div class="rounded-lg border overflow-hidden" style="border-color:var(--border)">
          {d.danceSpatial.map((r, i, arr) => (
            <div class="flex gap-3 px-4 py-2.5" style={`background-color:var(--bg-surface);${i < arr.length - 1 ? 'border-bottom:1px solid color-mix(in srgb, var(--border) 50%, transparent)' : ''}`}>
              <span class="text-xs font-bold w-24 shrink-0 pt-0.5" style="color:var(--gold)">{r.attr}</span>
              <span class="text-sm" style="color:var(--text-muted)">{r.val}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Timing diagram -->
    <div class="mt-4 mb-6 rounded-lg border p-4" style="border-color:var(--border);background-color:var(--bg-surface)">
      <div class="text-xs font-semibold uppercase tracking-widest mb-3" style="color:var(--text-muted)">{d.ui.timingDiagramHeading}</div>
      <canvas id="timingDiagram" height="88" style="width:100%;display:block"></canvas>
    </div>

    <!-- Musicality + Performance Context -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <div class="text-xs font-semibold uppercase tracking-widest mb-3" style="color:var(--text-muted)">{d.ui.musicalityMappingLabel}</div>
        <div class="rounded-lg border overflow-hidden" style="border-color:var(--border)">
          {d.danceMusicality.map((r, i, arr) => (
            <div class="flex gap-3 px-4 py-2.5" style={`background-color:var(--bg-surface);${i < arr.length - 1 ? 'border-bottom:1px solid color-mix(in srgb, var(--border) 50%, transparent)' : ''}`}>
              <span class="text-xs font-bold w-28 shrink-0 pt-0.5" style="color:var(--gold)">{r.elem}</span>
              <span class="text-sm" style="color:var(--text-muted)">{r.resp}</span>
            </div>
          ))}
        </div>
      </div>
      <div>
        <div class="text-xs font-semibold uppercase tracking-widest mb-3" style="color:var(--text-muted)">{d.ui.performanceContextLabel}</div>
        <div class="rounded-lg border overflow-hidden" style="border-color:var(--border)">
          {d.dancePerformanceCtx.map((r, i, arr) => (
            <div class="flex gap-3 px-4 py-2.5" style={`background-color:var(--bg-surface);${i < arr.length - 1 ? 'border-bottom:1px solid color-mix(in srgb, var(--border) 50%, transparent)' : ''}`}>
              <span class="text-xs font-bold w-28 shrink-0 pt-0.5" style="color:var(--gold)">{r.ctx}</span>
              <span class="text-sm" style="color:var(--text-muted)">{r.val}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── SKILL RADAR ── -->
  <section class="mb-10">
    <h2 class="wiki-section mb-2">{d.ui.skillRadarHeading}</h2>
    <p class="text-sm mb-4" style="color:var(--text-muted)">{d.ui.skillRadarIntro}</p>
    <div class="flex items-center gap-5 mb-6 flex-wrap">
      <div class="flex items-center gap-2"><span class="inline-block w-6 h-0.5 rounded" style="background-color:var(--gold)"></span><span class="text-xs font-semibold" style="color:var(--gold)">James Hwang</span></div>
      <div class="flex items-center gap-2"><span class="inline-block w-6 h-0.5 rounded" style="background-color:#60a5fa"></span><span class="text-xs font-semibold" style="color:#60a5fa">K-Idol Standard</span></div>
      <div class="flex items-center gap-2"><span class="inline-block w-6 h-0.5 rounded" style="background-color:#6b7280"></span><span class="text-xs font-semibold" style="color:#6b7280">Global Average</span></div>
    </div>
    <div class="flex flex-col md:flex-row gap-6 items-center">
      <div class="shrink-0">
        <canvas id="radarChart" width="320" height="320"></canvas>
      </div>
      <div class="flex-1 grid grid-cols-1 gap-2">
        {d.radarSkills.map((s, i) => (
          <div class="flex items-center gap-3">
            <div class="w-2.5 h-2.5 rounded-full shrink-0" style={`background-color:var(--gold);opacity:${0.5 + i * 0.07}`}></div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-2 mb-0.5">
                <span class="text-sm font-bold truncate">{s.name}</span>
                <span class="text-xs font-bold shrink-0" style="color:var(--gold)">{s.james}</span>
              </div>
              <div class="h-1.5 rounded-full overflow-hidden" style="background-color:var(--bg-muted)">
